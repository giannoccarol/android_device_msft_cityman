<?xml version="1.0" encoding="utf-8"?>
<!-- phh IMS (packages/apps/PhhIms): the app shares the system uid and is
     platform signed; list its privileged permissions anyway. -->
<permissions>
    <privapp-permissions package="me.phh.ims">
        <permission name="android.permission.READ_PRIVILEGED_PHONE_STATE"/>
        <permission name="android.permission.MODIFY_PHONE_STATE"/>
        <!-- periodic re-REGISTER alarm; missing it, system_server stops at
             boot (ro.control_privapp_permissions=enforce) -->
        <permission name="android.permission.SCHEDULE_EXACT_ALARM"/>
    </privapp-permissions>
</permissions>
