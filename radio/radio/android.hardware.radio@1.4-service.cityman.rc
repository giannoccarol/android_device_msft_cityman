# One wrapper per SIM slot. rild keeps serving IRadio@1.1 slotN and this
# service re-registers it as IRadio@1.4, the oldest HIDL version the
# Android 16 telephony stack accepts. The slot2 wrapper (-s) runs only on the
# dual SIM models, next to vendor.ril-daemon2 (persist.radio.multisim.config).
service vendor.radio-1-4-cityman /vendor/bin/hw/android.hardware.radio@1.4-service.cityman
    interface android.hardware.radio@1.0::IRadio slot1
    interface android.hardware.radio@1.1::IRadio slot1
    interface android.hardware.radio@1.2::IRadio slot1
    interface android.hardware.radio@1.3::IRadio slot1
    interface android.hardware.radio@1.4::IRadio slot1
    class hal
    user system
    group system

service vendor.radio-1-4-cityman2 /vendor/bin/hw/android.hardware.radio@1.4-service.cityman -s
    interface android.hardware.radio@1.0::IRadio slot2
    interface android.hardware.radio@1.1::IRadio slot2
    interface android.hardware.radio@1.2::IRadio slot2
    interface android.hardware.radio@1.3::IRadio slot2
    interface android.hardware.radio@1.4::IRadio slot2
    class hal
    user system
    group system
    disabled

on property:persist.radio.multisim.config=dsds
    enable vendor.radio-1-4-cityman2
