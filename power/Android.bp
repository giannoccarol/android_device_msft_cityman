// Device extension of android.hardware.power-service-qti
// (vendor/qcom/opensource/power), linked into it through the soong config
// variable qtipower/mode_ext_lib. Keep it a single source file: see the
// comment at the top of power-ext-cityman.cpp.
cc_library_static {
    name: "libpower_ext_cityman",
    vendor: true,
    defaults: ["android.hardware.power-ndk_shared"],
    srcs: ["power-ext-cityman.cpp"],
    header_libs: [
        "libhardware_headers",
        "qti_powerhal_headers",
    ],
    shared_libs: [
        "libcutils",
        "liblog",
    ],
    cflags: [
        "-Wall",
        "-Wextra",
        "-Werror",
    ],
}
