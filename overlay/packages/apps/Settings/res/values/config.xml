<resources xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">

    <!-- Enable color temperature setting. -->
    <bool name="config_enableColorTemperature">true</bool>

    <!-- The iris camera (face sensor) and the front camera share CSIPHY2 and cannot
         both be open: no front camera preview during face (iris) enrollment. -->
    <bool name="config_face_enroll_use_camera_preview">false</bool>

    <!-- Iris unlock is a weak (class 2) biometric: say it is less secure than a PIN. -->
    <bool name="config_face_intro_show_less_secure">true</bool>

</resources>
