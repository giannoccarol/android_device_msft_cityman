    <string name="biometric_dialog_face_icon_description_authenticating">Looking for your eyes</string>
    <string name="biometric_dialog_face_icon_description_authenticated">Iris authenticated</string>
    <string name="biometric_dialog_tap_confirm_with_face">Unlocked by iris</string>
    <string name="biometric_dialog_tap_confirm_with_face_alt_1">Unlocked by iris. Press to continue.</string>
    <string name="biometric_dialog_tap_confirm_with_face_alt_2">Iris recognized. Press to continue.</string>
    <string name="biometric_dialog_tap_confirm_with_face_alt_3">Iris recognized. Press the unlock icon to continue.</string>
    <string name="biometric_dialog_tap_confirm_with_face_sfps">Unlocked by iris. Tap to continue.</string>
    <string name="retry_face">Retry iris authentication</string>

