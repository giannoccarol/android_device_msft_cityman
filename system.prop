
#
# System prop for Lumia 950 XL (Cityman)
#

# Audio
persist.bt.enableAptXHD=true
persist.service.btui.use_aptx=1
persist.vendor.bt.a2dp_offload_cap=sbc-aptx-aptxtws-aptxhd-aac-ldac
persist.vendor.btstack.a2dp_offload_cap=sbc-aptx-aptxtws-aptxhd-aac-ldac
media.aac_51_output_enabled=true
ro.qc.sdk.audio.fluencetype=fluencepro
persist.audio.fluence.voicecall=true
persist.audio.fluence.voicecomm=true
persist.audio.fluence.voicerec=false
persist.audio.fluence.speaker=true
ro.config.vc_call_vol_steps=7
af.fast_track_multiplier=1
audio_hal.period_size=192
ro.audio.flinger_standbytime_ms=300

# Bluetooth
qcom.bluetooth.soc=rome
# The qcom-caf libbt-vendor of LineageOS 20 reads the vendor. name; without
# it the stack falls back to the SMD/WCNSS SoC type instead of Rome (UART).
vendor.qcom.bluetooth.soc=rome
# QCA Rome needs the APCF extended features off on Android 13 (libra).
bluetooth.le.disable_apcf_extended_features=1
bluetooth.enable_timeout_ms=12000

# Camera
persist.camera.eis.enable=0
persist.camera.is_type=4
persist.camera.tnr.preview=0
persist.camera.tnr.video=0
persist.camera.HAL3.enabled=1
ro.camera.notify_nfc=1

# Configstore
ro.surface_flinger.force_hwc_copy_for_virtual_displays=true
ro.surface_flinger.max_frame_buffer_acquired_buffers=3
ro.surface_flinger.max_virtual_display_dimension=2048
# No window/shade blurs on the Adreno 430 (SystemUI, Launcher and
# SurfaceFlinger only check this property on Android 16).
ro.surface_flinger.supports_background_blur=0

# CTS
ro.product.first_api_level=23

# Dalvik
dalvik.vm.boot-dex2oat-threads=4
dalvik.vm.dex2oat-threads=4
dalvik.vm.image-dex2oat-threads=4
dalvik.vm.dex2oat-cpu-set=0,1,2,3
dalvik.vm.boot-dex2oat-cpu-set=0,1,2,3
dalvik.vm.background-dex2oat-threads=2
dalvik.vm.background-dex2oat-cpu-set=0,1,2,3
dalvik.vm.restore-dex2oat-threads=4
dalvik.vm.restore-dex2oat-cpu-set=0,1,2,3

# Disable rescue party
persist.sys.disable_rescue=true

# Display
ro.opengles.version=196610
ro.hardware.egl=adreno
# SurfaceFlinger composes with the GLES engine restored by the legacy
# patches; never pick Vulkan (the Adreno 430 driver is Vulkan 1.0).
debug.renderengine.backend=skiaglthreaded
# No ADPF sessions: there is no uclamp and the power HAL ignores them.
debug.sf.enable_adpf_cpu_hint=false
# Launcher: no depth (wallpaper zoom) effects on overview and widgets.
ro.launcher.depth.overview=false
ro.launcher.depth.widget=false
ro.sf.lcd_density=564
persist.hwc.mdpcomp.enable=true

# DRM
drm.service.enabled=true

# Faceunlock
ro.facelock.black_timeout=700
ro.facelock.det_timeout=2500
ro.facelock.rec_timeout=3500
ro.facelock.est_max_time=600

# FRP
ro.frp.pst=/dev/block/platform/soc.0/f9824900.sdhci/by-name/persistent

# Media
debug.stagefright.omx_default_rank.sw-audio=1
debug.stagefright.omx_default_rank=0
vidc.debug.perf.mode=2
vidc.enc.dcvs.extra-buff-count=2
media.recorder.show_manufacturer_and_model=true
persist.media.treble_omx=false

# Perf
ro.min_freq_0=384000
ro.min_freq_4=384000

# IMS
persist.dbg.ims_volte_enable=1
persist.dbg.volte_avail_ovr=1
persist.dbg.vt_avail_ovr=1
persist.dbg.wfc_avail_ovr=1

# Properties for Surfaceflinger: AOSP default durations for a single 60 Hz
# mode (about two frames less touch latency than the old 27.6 ms values).
debug.sf.use_phase_offsets_as_durations=1

# lmkd: PSI monitors with the new strategy. Never set use_psi=false or
# use_minfree_levels=true here: lmkd would ask for memcg v1, exit and the
# phone would reboot in a loop.
ro.lmk.use_psi=true
ro.lmk.use_new_strategy=true
ro.lmk.use_minfree_levels=false
ro.lmk.psi_partial_stall_ms=70
ro.lmk.psi_complete_stall_ms=400
ro.lmk.swap_free_low_percentage=20
ro.lmk.kill_heaviest_task=true
ro.lmk.kill_timeout_ms=100
ro.lmk.debug=true

# HWUI: apps in the background drop all unlocked GPU resources (kgsl
# memory cannot go to zram)
debug.hwui.app_memory_policy=lowram
# Battery saver: no dark theme switch, which recreates every activity
ro.config.night_mode_on_battery_saver=false
# Bigger logd buffers while Android 16 is being brought up
ro.logd.size=1M

# RIL
ro.vendor.extension_library=libqti-perfd-client.so
# Android 13 rild (PRODUCT_COMPATIBLE_PROPERTY) only reads the vendor. names.
vendor.rild.libpath=/vendor/lib64/libril-qc-qmi-1.so
ro.telephony.default_cdma_sub=0
persist.qcril.disable_retry=true
persist.radio.always_send_plmn=true
ro.telephony.call_ring.multiple=0
persist.radio.use_cc_names=true
persist.radio.eri64_as_home=1
persist.radio.rat_on=combine
persist.radio.data_ltd_sys_ind=1
persist.radio.data_con_rprt=1
persist.radio.calls.on.ims=1
persist.radio.apm_sim_not_pwdn=1
persist.radio.custom_ecc=1
persist.radio.data_no_toggle=1
persist.radio.process_sups_ind=1
ro.telephony.default_network=22
telephony.lteOnCdmaDevice=1
persist.radio.mode_pref_nv10=1
ril.nosim.ecc_list_count=1
ril.nosim.ecc_list_1=111,113,117,122,125
persist.radio.redir_party_num=0

# No FUSE passthrough in the 3.10 kernel
persist.sys.fuse.passthrough.enable=false

# Wifi
wifi.interface=wlan0
wifi.supplicant_scan_interval=15


# ACDB: the loader does not find the files on its own, list them. The
# Cityman files match the Cityman ADSP firmware.
persist.audio.calfile0=/vendor/etc/acdbdata/cityman/Cityman_Bluetooth_cal.acdb
persist.audio.calfile1=/vendor/etc/acdbdata/cityman/Cityman_General_cal.acdb
persist.audio.calfile2=/vendor/etc/acdbdata/cityman/Cityman_Global_cal.acdb
persist.audio.calfile3=/vendor/etc/acdbdata/cityman/Cityman_Handset_cal.acdb
persist.audio.calfile4=/vendor/etc/acdbdata/cityman/Cityman_Hdmi_cal.acdb
persist.audio.calfile5=/vendor/etc/acdbdata/cityman/Cityman_Headset_cal.acdb
persist.audio.calfile6=/vendor/etc/acdbdata/cityman/Cityman_Speaker_cal.acdb
