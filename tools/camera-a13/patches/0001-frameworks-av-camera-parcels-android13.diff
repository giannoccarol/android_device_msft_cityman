+            return BAD_VALUE;
+        }
+    }
+
     return OK;
 }
 
@@ -213,6 +227,8 @@ status_t CaptureRequest::writeToParcel(android::Parcel* parcel) const {
             return err;
         }
     }
+    // Android 13 framework layout: no user tag.
+    if ((err = parcel->writeInt32(0)) != OK) return err;
     return OK;
 }
 
diff --git a/frameworks/av/camera/camera2/OutputConfiguration.cpp b/frameworks/av/camera/camera2/OutputConfiguration.cpp
index 2bccd87..0b09600 100644
--- a/frameworks/av/camera/camera2/OutputConfiguration.cpp
+++ b/frameworks/av/camera/camera2/OutputConfiguration.cpp
@@ -165,6 +165,19 @@ status_t OutputConfiguration::readFromParcel(const android::Parcel* parcel) {
         ALOGE("%s: Failed to read sensor pixel mode(s) from parcel", __FUNCTION__);
         return err;
     }
+
+    // The Android 13 framework also sends the dynamic range profile, stream
+    // use case, timestamp base and mirror mode. This Android 12 service does
+    // not use them; read them so the parcel layout matches.
+    int64_t dynamicProfile, streamUseCase;
+    int32_t timestampBase, mirrorMode;
+    if ((err = parcel->readInt64(&dynamicProfile)) != OK ||
+            (err = parcel->readInt64(&streamUseCase)) != OK ||
+            (err = parcel->readInt32(&timestampBase)) != OK ||
+            (err = parcel->readInt32(&mirrorMode)) != OK) {
+        ALOGE("%s: Failed to read Android 13 output fields from parcel", __FUNCTION__);
+        return err;
+    }
     mRotation = rotation;
     mSurfaceSetID = setID;
     mSurfaceType = surfaceType;
@@ -254,6 +267,13 @@ status_t OutputConfiguration::writeToParcel(android::Parcel* parcel) const {
     err = parcel->writeParcelableVector(mSensorPixelModesUsed);
     if (err != OK) return err;
 
+    // Android 13 framework layout: STANDARD dynamic range, DEFAULT stream use
+    // case and timestamp base, AUTO mirror mode.
+    if ((err = parcel->writeInt64(1)) != OK) return err;
+    if ((err = parcel->writeInt64(0)) != OK) return err;
+    if ((err = parcel->writeInt32(0)) != OK) return err;
+    if ((err = parcel->writeInt32(0)) != OK) return err;
+
     return OK;
 }
 
