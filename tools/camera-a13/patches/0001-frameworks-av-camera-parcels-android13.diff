diff --git a/frameworks/av/camera/camera2/CaptureRequest.cpp b/frameworks/av/camera/camera2/CaptureRequest.cpp
index ebc09d7..1d90ba4 100644
--- a/frameworks/av/camera/camera2/CaptureRequest.cpp
