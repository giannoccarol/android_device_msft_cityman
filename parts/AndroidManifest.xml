<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="org.lineageos.cityman.parts"
    android:sharedUserId="android.uid.system">

    <application
        android:label="@string/app_name"
        android:icon="@drawable/ic_perf_profile"
        android:allowBackup="false"
        android:supportsRtl="true"
        android:theme="@style/Theme.SubSettingsBase">

        <!-- Settings > Battery > Performance profile -->
        <activity
            android:name=".PerformanceProfileActivity"
            android:label="@string/perf_profile_title"
            android:exported="true">
            <intent-filter>
                <action android:name="com.android.settings.action.IA_SETTINGS" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE_PREFERENCES" />
            </intent-filter>
            <meta-data
                android:name="com.android.settings.category"
                android:value="com.android.settings.category.ia.battery" />
            <meta-data
                android:name="com.android.settings.title"
                android:resource="@string/perf_profile_title" />
            <meta-data
                android:name="com.android.settings.summary_uri"
                android:value="content://org.lineageos.cityman.parts.summary/getDynamicSummary" />
            <meta-data
                android:name="com.android.settings.icon"
                android:resource="@drawable/ic_perf_profile" />
        </activity>

        <provider
            android:name=".SummaryProvider"
            android:authorities="org.lineageos.cityman.parts.summary"
            android:exported="true" />

        <service
            android:name=".PerformanceProfileTileService"
            android:label="@string/perf_profile_tile_label"
            android:icon="@drawable/ic_perf_profile"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
    </application>
</manifest>
