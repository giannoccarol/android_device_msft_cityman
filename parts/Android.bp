// Device settings: the performance profiles in Settings > Battery and a
// Quick Settings tile (power/README.md). No launcher entry.
android_app {
    name: "CitymanParts",
    srcs: ["src/**/*.java"],
    resource_dirs: ["res"],
    certificate: "platform",
    platform_apis: true,
    system_ext_specific: true,

    static_libs: [
        "androidx.core_core",
        "androidx.preference_preference",
        "SettingsLibCollapsingToolbarBaseActivity",
        "SettingsLibFooterPreference",
        "SettingsLibSelectorWithWidgetPreference",
        "SettingsLibSettingsTheme",
    ],

    optimize: {
        enabled: false,
    },
}
