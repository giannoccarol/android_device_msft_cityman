<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    android:title="@string/perf_profile_title">

    <com.android.settingslib.widget.SelectorWithWidgetPreference
        android:key="profile_power_save"
        android:title="@string/profile_power_save"
        android:summary="@string/profile_power_save_summary"
        android:persistent="false" />

    <com.android.settingslib.widget.SelectorWithWidgetPreference
        android:key="profile_balanced"
        android:title="@string/profile_balanced"
        android:summary="@string/profile_balanced_summary"
        android:persistent="false" />

    <com.android.settingslib.widget.SelectorWithWidgetPreference
        android:key="profile_performance"
        android:title="@string/profile_performance"
        android:summary="@string/profile_performance_summary"
        android:persistent="false" />

    <com.android.settingslib.widget.FooterPreference
        android:key="battery_saver_note"
        android:title="@string/profile_battery_saver_note"
        android:selectable="false" />

</PreferenceScreen>
